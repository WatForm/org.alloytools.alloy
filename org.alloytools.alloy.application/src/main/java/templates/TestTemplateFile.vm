def random_subset(s):
    return set([e for e in s if random.randint(0, 1) == 0])

def powerset(iterable):
    s = list(iterable)
    return set(itertools.chain.from_iterable(itertools.combinations(s, r) for r in range(len(s)+1)))

class MultiLevelExit(Exception):
    "Exception type used to perform multi level exit"
    pass


class MetaSet(type):
    """
    Used by variables to make operations consistent.
    - static variable is a class and a dynamic variable is an instance
    """

    class Set:
        """
        Everything will be turned into a set. Set of strings or set of tuples.
        """
        def __init__(self, initvalue=()):
            if isinstance(initvalue, MetaSet.Set):
                self._set = initvalue._set
            elif isinstance(initvalue, set):
                self._set = initvalue
            elif isinstance(initvalue, list):
                self._set = set(initvalue)
            elif isinstance(initvalue, MetaSet):
                self._set = initvalue.objects()
            elif isinstance(initvalue, Signature):
                self._set = set(initvalue.elements)
            elif isinstance(initvalue, Relation):
                self._set = initvalue.values
            elif isinstance(initvalue, tuple):
                self._set = {initvalue}
            elif isinstance(initvalue, str):
                self._set = {initvalue}
            elif isinstance(initvalue, dict):
                self._set = set(initvalue.values())
            elif isinstance(initvalue, int):
                self._set = {initvalue}
            else:
                print("Exception, unsupported type in MetaSet::Set: %s", type(initvalue))

        def __len__(cls):
            return len(cls._set)

        def __iter__(cls) -> iter:
            _list = list(cls._set)
            random.shuffle(_list)
            return iter([MetaSet.Set(e) for e in _list])

        def __repr__(cls):
            return str(cls._set)

        def __eq__(cls, other):
            if not isinstance(other, MetaSet.Set):
                return cls == MetaSet.Set(other)
            return cls._set == other._set

        # override "in" operator, e.g.,: other in cls
        def __contains__(cls, other) -> bool:
            if not isinstance(other, MetaSet.Set):
                return MetaSet.Set(other) in cls
            return other._set.issubset(cls._set)

        # override "+" operator, e.g.,: cls + other
        def __add__(cls, other) -> MetaSet.Set:
            if not isinstance(other, MetaSet.Set):
                return cls + MetaSet.Set(other)
            return MetaSet.Set(cls._set.union(other._set))

        # override "-" operator, e.g.,: cls - other
        def __sub__(cls, other) -> MetaSet.Set:
            if not isinstance(other, MetaSet.Set):
                return cls - MetaSet.Set(other)
            return MetaSet.Set(cls._set.difference(other._set))

        # override "*" operator as cartesian product
        def __mul__(cls, other) -> set(tuple):
            return set(itertools.product(cls._set, other._set))

        # override "^" operator as join
        def __xor__(cls, other) -> set(tuple):
            if not isinstance(other, MetaSet.Set):
                return cls ^ MetaSet.Set(other)
            ret = set()
            for i in cls._set:
                for j in other._set:
                    if isinstance(i, str):
                        i = tuple([i])
                    if isinstance(j, str):
                        j = tuple([j])
                    if len(i) + len(j) > 2 and i[-1] == j[0]:
                        if len(i[:-1] + j[1:]) == 1:
                            ret.add((i[:-1] + j[1:])[0])
                        else:
                            ret.add(i[:-1] + j[1:])
            return MetaSet.Set(ret)

    def __len__(cls):
        return len(cls.objects())

    def __iter__(cls) -> iter:
        return iter(MetaSet.Set(cls.objects()))

    def __repr__(cls) -> str:
        return f"{cls.__name__}: " + f"{cls.objects()}" if cls.objects() else "Empty"

    # override "in" operator, e.g.,: other in cls
    def __contains__(cls, other):
        return  MetaSet.Set(other) in MetaSet.Set(cls.objects())

    # override "+" operator, e.g.,: cls + other
    def __add__(cls, other):
        return MetaSet.Set(cls.objects()) + MetaSet.Set(other)

    # override "-" operator, e.g.,: cls - other
    def __sub__(cls, other):
        return MetaSet.Set(cls.objects()) - MetaSet.Set(other)

    # override "*" operator as cartesian product
    def __mul__(cls, other) -> set(tuple):
        return MetaSet.Set(cls.objects()) * MetaSet.Set(other)

    # override "^" operator as join
    def __xor__(cls, other) -> set(tuple):
        return MetaSet.Set(cls.objects()) ^ MetaSet.Set(other)

    # all objects in this static variable
    def objects(cls) -> set:
        if hasattr(cls, 'values'): # Relation
            return cls.values
        return cls.atoms           # Signature


class Multiplicity(Enum):
    Lone = 0
    One = 1
    Some = 2
    Set = 3


class Signature(metaclass = MetaSet):
    def __init__(self, name, multiplicity, elements=set()):
        """
        Used by state variables
        - the member variables and functions will be used by state variables

        :param str name: the name of this state variable
        :param enum multiplicity: the multiplicity type of this state variable
        :member set elements: all the elements in this instance (state variable)
        """
        # for state variables:
        self.name = name
        self.multiplicity = multiplicity
        self.elements = elements

    # Return elements
    def get_values(self) -> set:
        return self.elements

    # Returns true if the new set of elements is valid for its multiplicity
    def is_valid(self, new_elements) -> bool:
        length = len(new_elements)
        if self.multiplicity == Multiplicity.Lone:
            if(length != 0 and length != 1):
                return False
        elif self.multiplicity == Multiplicity.One:
            if(length != 1):
                return False
        elif self.multiplicity == Multiplicity.Some:
            if(length == 0):
                return False
        return True

    # returns true if successfully set the new set of elements for this state variable
    def update_value(self, new_elements) -> bool:
        if(self.is_valid(new_elements)):
            self.elements = new_elements
            return True
        return False

    def generate_random_value(self):
        if self.multiplicity == Multiplicity.Lone:
            if len(self.atoms) == 0 or random.randint(0, 1) == 0:
                return set()
            else:
                return set(random.sample(sorted(self.atoms), 1))
        elif self.multiplicity == Multiplicity.One:
            return set(random.sample(sorted(self.atoms), 1))
        elif self.multiplicity == Multiplicity.Some:
            if len(self.atoms) == 0:
                print("Exception, empty signature cannot support some multiplicity")
                exit(1)
            while True:
                ret = random_subset(self.atoms)
                if len(ret):
                    return ret
        else: # Set
            return random_subset(self.atoms)

    def possible_next_values(self):
        ret = []
        if self.multiplicity == Multiplicity.Lone:
            ret = [set(i) for i in self.atoms] + [set()]
        elif self.multiplicity == Multiplicity.One:
            ret = [set(i) for i in self.atoms]
        elif self.multiplicity == Multiplicity.Some:
            ret = list(powerset(self.atoms) - set(set()))
        else: # Set
            ret = list(powerset(self.atoms))
        random.shuffle(ret)
        return ret

    def __len__(self) -> int:
        return len(self.elements)

    def __iter__(self) -> iter:
        return iter(MetaSet.Set(self.elements))

    def __repr__(self):
        return f"{self.__class__.__name__} - {self.name} : " + f"{self.elements}" if self.elements else "Empty"

    def __eq__(self, other: object) -> bool:
        return MetaSet.Set(other) == MetaSet.Set(self.elements)

    # override "in" operator, e.g.,: other in self
    def __contains__(self, other):
        return  MetaSet.Set(other) in MetaSet.Set(self.elements)

    # override "+" operator, e.g.,: self + other
    def __add__(self, other):
        return MetaSet.Set(self.elements) + MetaSet.Set(other)

    # override "-" operator, e.g.,: self - other
    def __sub__(self, other):
        return MetaSet.Set(self.elements) - MetaSet.Set(other)

    # override "*" operator as cartesian product
    def __mul__(self, other) -> set(tuple):
        return MetaSet.Set(self.elements) * MetaSet.Set(other)

    # override "^" operator as join
    def __xor__(self, other) -> set(tuple):
        return MetaSet.Set(self.elements) ^ MetaSet.Set(other)

class Relation(metaclass = MetaSet):
    def __init__(self, name, types, values=set()):
        """
        Used by state variables
        - the member variables and functions will be used by state variables

        :param str name: the name of this state variable
        :param list[string] types: the types of this state variable
        :member set values: all the tuples in this instance (state variable)
        """
        # for state variables:
        self.name = name
        self.types = types
        self.values = values

    def possible_tuples(self) -> set:
        domain_elements = [type.objects() for type in self.types]
        return set([tup for tup in itertools.product(*domain_elements)])

    def get_values(self) -> set:
        return self.values

    def generate_random_value(self):
        return random_subset(self.possible_tuples())

    def possible_next_values(self):
        ret = list(powerset(self.possible_tuples()))
        random.shuffle(ret)
        return ret

    # Returns true if the new set of tuples is valid for its types
    def is_valid(self, values) -> bool:
        for v in values:
            if len(self.types) != len(v):
                return False
            for t, e in zip(self.types, v):
                if e not in t:
                    return False
        return True

    # returns true if successfully set the new set of tuples for this state variable
    def update_value(self, new_values) -> bool:
        if (self.is_valid(new_values)):
            self.values = new_values
            return True
        return False

    def __len__(self) -> int:
        return len(self.values)

    def __iter__(self) -> iter:
        return iter(MetaSet.Set(self.values))

    def __repr__(self):
        return f"{self.__class__.__name__} - {self.name} : " + f"{self.values}" if self.values else "Empty"

    # override "in" operator, e.g.,: other in self
    def __contains__(self, other):
        return  MetaSet.Set(other) in MetaSet.Set(self.values)

    # override "+" operator, e.g.,: self + other
    def __add__(self, other):
        return MetaSet.Set(self.values) + MetaSet.Set(other)

    # override "-" operator, e.g.,: self - other
    def __sub__(self, other):
        return MetaSet.Set(self.values) - MetaSet.Set(other)

    # override "^" operator as join
    def __xor__(self, other) -> set(tuple):
        return MetaSet.Set(self.values) ^ MetaSet.Set(other)

