def input_env_var(env_var, var_name, hint):
    while True:
        print(f'Environment variable {var_name}({hint}) currently has value {env_var.get_values()}.')
        input_value = input(f'Please enter new value for environment variable {var_name}:')
        # leave value unchanged
        if input_value == "unchanged":
            return
        # generate random values
        if input_value == "random":
            new_value = env_var.generate_random_value()
            print("Randomly generated value: " + str(new_value))
            if not env_var.update_value(new_value):
                print("Exception, unexpected state")
                exit(1)
            return
        # update values
        if env_var.update_value(literal_eval(input_value)):
            return
        print("Invalid Value! Try again.")

